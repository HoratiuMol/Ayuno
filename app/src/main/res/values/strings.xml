    <!-- Planes de ayuno: contenido -->
    <string name="plan_12_12_name">12:12</string>
    <string name="plan_12_12_subtitle">Iniciación</string>
    <string name="plan_12_12_desc">Un ayuno suave de 12 horas, ideal para empezar a familiarizarte con el ayuno intermitente sin apenas esfuerzo.</string>
    <string name="plan_12_12_schedule">Ej.: cena a las 20:00, desayuno a las 08:00</string>

    <string name="plan_14_10_name">14:10</string>
    <string name="plan_14_10_subtitle">Progresión</string>
    <string name="plan_14_10_desc">Amplía ligeramente la ventana de ayuno mientras tu cuerpo se adapta al método.</string>
    <string name="plan_14_10_schedule">Ej.: cena a las 20:00, desayuno a las 10:00</string>

    <string name="plan_16_8_name">16:8</string>
    <string name="plan_16_8_subtitle">Leangains</string>
    <string name="plan_16_8_desc">El método de ayuno intermitente más popular: 16 horas de ayuno y una ventana de 8 horas para comer.</string>
    <string name="plan_16_8_schedule">Ej.: cena a las 20:00, comida a las 12:00</string>

    <string name="plan_18_6_name">18:6</string>
    <string name="plan_18_6_subtitle">Ventana reducida</string>
    <string name="plan_18_6_desc">Reduce la ventana de alimentación a 6 horas para profundizar en los beneficios metabólicos del ayuno.</string>
    <string name="plan_18_6_schedule">Ej.: cena a las 18:00, comida a las 12:00</string>

    <string name="plan_20_4_name">20:4</string>
    <string name="plan_20_4_subtitle">Warrior Diet</string>
    <string name="plan_20_4_desc">Una única ventana de 4 horas para comer al día; requiere experiencia previa con ayunos más cortos.</string>
    <string name="plan_20_4_schedule">Ej.: una comida principal entre las 16:00 y las 20:00</string>

    <string name="plan_omad_name">OMAD</string>
    <string name="plan_omad_subtitle">Una comida al día</string>
    <string name="plan_omad_desc">One Meal A Day: 23 horas de ayuno con una única comida diaria. Máxima simplicidad, requiere experiencia.</string>
    <string name="plan_omad_schedule">Ej.: una única comida a las 18:00</string>

    <string name="plan_adf_name">ADF</string>
    <string name="plan_adf_subtitle">Días alternos</string>
    <string name="plan_adf_desc">Alternate Day Fasting: ayunos completos de 24 horas en días alternos, combinados con días de alimentación normal.</string>
    <string name="plan_adf_schedule">Ej.: ayuna un día sí y un día no</string>

    <string name="plan_5_2_name">5:2</string>
    <string name="plan_5_2_subtitle">Restricción calórica</string>
    <string name="plan_5_2_desc">5 días de alimentación normal y 2 días no consecutivos con ingesta muy reducida. Aquí, cada día de restricción se registra como un ayuno de 24h.</string>
    <string name="plan_5_2_schedule">Ej.: restricción los lunes y jueves</string>

