    <!-- Fasting plans: content -->
    <string name="plan_12_12_name">12:12</string>
    <string name="plan_12_12_subtitle">Getting started</string>
    <string name="plan_12_12_desc">A gentle 12-hour fast, ideal for getting used to intermittent fasting with barely any effort.</string>
    <string name="plan_12_12_schedule">E.g.: dinner at 8pm, breakfast at 8am</string>

    <string name="plan_14_10_name">14:10</string>
    <string name="plan_14_10_subtitle">Progression</string>
    <string name="plan_14_10_desc">Slightly extends the fasting window while your body adapts to the method.</string>
    <string name="plan_14_10_schedule">E.g.: dinner at 8pm, breakfast at 10am</string>

    <string name="plan_16_8_name">16:8</string>
    <string name="plan_16_8_subtitle">Leangains</string>
    <string name="plan_16_8_desc">The most popular intermittent fasting method: 16 hours of fasting and an 8-hour eating window.</string>
    <string name="plan_16_8_schedule">E.g.: dinner at 8pm, lunch at noon</string>

    <string name="plan_18_6_name">18:6</string>
    <string name="plan_18_6_subtitle">Narrower window</string>
    <string name="plan_18_6_desc">Shrinks the eating window to 6 hours to deepen the metabolic benefits of fasting.</string>
    <string name="plan_18_6_schedule">E.g.: dinner at 6pm, lunch at noon</string>

    <string name="plan_20_4_name">20:4</string>
    <string name="plan_20_4_subtitle">Warrior Diet</string>
    <string name="plan_20_4_desc">A single 4-hour eating window per day; requires prior experience with shorter fasts.</string>
    <string name="plan_20_4_schedule">E.g.: one main meal between 4pm and 8pm</string>

    <string name="plan_omad_name">OMAD</string>
    <string name="plan_omad_subtitle">One meal a day</string>
    <string name="plan_omad_desc">One Meal A Day: 23 hours of fasting with a single daily meal. Maximum simplicity, requires experience.</string>
    <string name="plan_omad_schedule">E.g.: a single meal at 6pm</string>

    <string name="plan_adf_name">ADF</string>
    <string name="plan_adf_subtitle">Alternate days</string>
    <string name="plan_adf_desc">Alternate Day Fasting: full 24-hour fasts on alternating days, combined with normal eating days.</string>
    <string name="plan_adf_schedule">E.g.: fast every other day</string>

    <string name="plan_5_2_name">5:2</string>
    <string name="plan_5_2_subtitle">Calorie restriction</string>
    <string name="plan_5_2_desc">5 days of normal eating and 2 non-consecutive days with very reduced intake. Here, each restriction day is logged as a 24h fast.</string>
    <string name="plan_5_2_schedule">E.g.: restrict on Mondays and Thursdays</string>

