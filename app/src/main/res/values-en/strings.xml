    <!-- Fasting guide -->
    <string name="guide_title">Fasting guide</string>
    <string name="guide_subtitle">Learn what happens in your body during each phase of fasting, its benefits, and the precautions to keep in mind.</string>
    <string name="guide_considerations_title">General considerations</string>
    <string name="guide_tip_1">Always stay well hydrated: water, herbal tea and coffee are the only things allowed.</string>
    <string name="guide_tip_2">Not recommended for children, pregnant women, the elderly, or people with eating disorders.</string>
    <string name="guide_tip_3">Fasts longer than 24h require medical supervision.</string>
    <string name="guide_tip_4">If you experience persistent dizziness, binge eating, extreme irritability, or a drop in performance, stop the fast.</string>
    <string name="guide_tip_5">It\'s best to start gradually: 12/12, then 14/10, then 16/8.</string>

