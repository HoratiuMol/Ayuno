    <!-- Metabolic fasting phases -->
    <string name="phase_postprandial_name">Postprandial phase</string>
    <string name="phase_postprandial_desc">Your body is using the energy from the food you just ate. The pancreas produces insulin to use the glucose and store the excess as glycogen and fat.</string>
    <string name="phase_postprandial_motivation">Discipline begins the moment you finish eating</string>
    <string name="phase_postprandial_benefit_1">Active digestion and nutrient absorption</string>
    <string name="phase_postprandial_benefit_2">Liver and muscle glycogen storage</string>
    <string name="phase_postprandial_caution_1">Intense exercise right after eating isn\'t recommended</string>

    <string name="phase_glycogen_name">Burning reserves</string>
    <string name="phase_glycogen_desc">Your body starts using its glycogen reserves. Glucose stored in the liver keeps blood levels stable. Gluconeogenesis and lipolysis kick in.</string>
    <string name="phase_glycogen_motivation">Your body is learning to use its reserves</string>
    <string name="phase_glycogen_benefit_1">Stored fat burning begins</string>
    <string name="phase_glycogen_benefit_2">Ketone body production for energy</string>
    <string name="phase_glycogen_benefit_3">Autophagy begins (cellular renewal)</string>
    <string name="phase_glycogen_benefit_4">Increased insulin sensitivity</string>
    <string name="phase_glycogen_caution_1">You may feel hungry or slightly irritable</string>
    <string name="phase_glycogen_caution_2">Stay well hydrated</string>

    <string name="phase_early_ketosis_name">Early ketosis</string>
    <string name="phase_early_ketosis_desc">Glucose in the cells and glycogen run out. Your body burns stored fat as its main energy source. Autophagy intensifies.</string>
    <string name="phase_early_ketosis_motivation">Discomfort forges control and clarity</string>
    <string name="phase_early_ketosis_benefit_1">Active body fat burning</string>
    <string name="phase_early_ketosis_benefit_2">More intense autophagy: cellular cleanup</string>
    <string name="phase_early_ketosis_benefit_3">Lipid profile regulation</string>
    <string name="phase_early_ketosis_benefit_4">Improved insulin sensitivity</string>
    <string name="phase_early_ketosis_caution_1">Possible headache if you\'re not hydrated</string>
    <string name="phase_early_ketosis_caution_2">Not recommended without prior fasting experience</string>

    <string name="phase_deep_ketosis_name">Deep ketosis</string>
    <string name="phase_deep_ketosis_desc">Your body enters full ketosis: it burns fat reserves for energy. Ketone bodies act as fuel for the brain.</string>
    <string name="phase_deep_ketosis_motivation">You\'re burning fat now, keep going</string>
    <string name="phase_deep_ketosis_benefit_1">Improved cognitive performance and mental clarity</string>
    <string name="phase_deep_ketosis_benefit_2">Greater sense of energy and well-being</string>
    <string name="phase_deep_ketosis_benefit_3">Reduced triglycerides and LDL cholesterol</string>
    <string name="phase_deep_ketosis_benefit_4">Deep cellular renewal (autophagy)</string>
    <string name="phase_deep_ketosis_benefit_5">Possible protective effect against cancer and aging</string>
    <string name="phase_deep_ketosis_caution_1">Requires medical supervision</string>
    <string name="phase_deep_ketosis_caution_2">Not suitable for beginners</string>
    <string name="phase_deep_ketosis_caution_3">Make sure to drink water, herbal teas and electrolytes</string>
    <string name="phase_deep_ketosis_caution_4">Stop if persistent dizziness or weakness appears</string>

    <string name="phase_extended_ketosis_name">Extended ketosis</string>
    <string name="phase_extended_ketosis_desc">A deep state of ketosis. Every organ runs on ketone bodies and fats. Thyroid hormones may be affected.</string>
    <string name="phase_extended_ketosis_motivation">Your body is renewing itself from within</string>
    <string name="phase_extended_ketosis_benefit_1">Maximum autophagy and cellular renewal</string>
    <string name="phase_extended_ketosis_benefit_2">Greater resistance to stress and toxins</string>
    <string name="phase_extended_ketosis_benefit_3">Hunger tends to decrease from the third day onward</string>
    <string name="phase_extended_ketosis_caution_1">⚠️ ONLY under strict medical supervision</string>
    <string name="phase_extended_ketosis_caution_2">Thyroid hormones may become altered</string>
    <string name="phase_extended_ketosis_caution_3">Metabolism may be negatively affected</string>
    <string name="phase_extended_ketosis_caution_4">Not suitable for people with eating disorders, pregnant women, children or the elderly</string>
    <string name="phase_extended_ketosis_caution_5">Stop immediately if fainting or confusion occurs</string>

